# Public project settings from Supabase > Project Settings > API / API Keys.
# Never use a service_role key or an sb_secret_ key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Older projects can use VITE_SUPABASE_ANON_KEY instead of the publishable key.
